-- ═══════════════════════════════════════════════════════════════
--  这是你要改的文件：src/user/main.ev
--
--  · 一行一条指令，从上往下执行
--  · 中文直接写，UTF-8 就行（引擎自动转换，不用管编码）
--  · 改完保存，重新运行就能看到效果，不用打包
--
--  写台词的固定套路：一句 text(...)，紧跟一句 textcl()
-- ═══════════════════════════════════════════════════════════════


*start

msgboxon()                        -- 显示对话框，游戏开始调一次

bg("backdrop.png")                -- 换背景（自带淡入和停顿）


-- ── 台词 ────────────────────────────────────────────────
--  text("内容")            没有名字的台词
--  text("名字","内容")     带名字的台词
--  textcl()                结束这一句，清屏进入下一框

text("欢迎来到 PGM for Mac。")
textcl()

text("你现在看到的这段话，就写在这个文件里。")
textcl()

text("用任何编辑器打开 src/user/main.ev 都能改，")
textcl()

text("改完保存、重新运行就看到效果了。")
textcl()


-- ── 带名字的台词 ────────────────────────────────────────

text("旁白","中文不用做任何处理，直接敲进去就可以。")
textcl()

text("[c=FFD700]这句是金色的。[/c]  [c=00FF88]这句是绿色的。[/c]")
textcl()


-- ── 放立绘：图片丢进 src/files/fg/，这里写文件名 ─────────
--   fg("立绘.png")              默认居中
--   fg("立绘.png",LEFT)         靠左（还有 RIGHT）
--   fgcl()                      清掉立绘


-- ── 放音乐：mp3 丢进 bin/data/bgm/，这里写文件名 ─────────
--   bgm("音乐.mp3")
--   bgmstop()                   停止


-- ── 选项：文字, 跳转标签 成对写，标签以 * 开头 ───────────

drawramus("再讲一遍",*again,"结束",*quit)


*again
text("好，那我们从头再来。")
textcl()
goto(*start)


*quit
text("改完记得保存，然后重新运行。")
textcl()
text("祝顺利。")
textcl()

jump("main.ev")                   -- 回到开头
