
-- ===================================================================
*begin
-- 清空所有资源
allclear()
-- 重置所有变量
AllVarReset()
-- 加载所有变量
pubdata_checkup()
-- 初始化文本模式
speakmode(speak_mode_sample)
-- 初始化mp3(空白视频，不可删除)
pmplay("system/test.pmp")
-- 初始化历史回想
historybegin()
-- 初始化字体
font(FONT,FONTSIZE)
fontwidth(FONTWIDTH,FONTHEIGHT)

-- ===================================================================
-- 你的剧本从这里开始：src/user/main.ev
-- 想换入口改下面这行就行
jump("main.ev")
