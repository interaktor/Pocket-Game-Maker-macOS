-- ===================================================================
--  启动脚本 —— 一般不用动
--
--  这个文件只做初始化，然后跳到 src/user/main.ev 开始你的剧情。
--  想调对话框/选项的位置，去改 src/user/config.lua
-- ===================================================================

*begin

allclear()                        -- 清空所有资源
AllVarReset()                     -- 重置所有变量
pubdata_checkup()                 -- 加载存档里的变量

speakmode(speak_mode_sample)      -- 文字模式
pmplay("system/test.pmp")         -- 初始化 mp3（内部用，别删）
historybegin()                    -- 初始化历史回想

font(FONT, FONTSIZE)              -- 字体
fontwidth(FONTWIDTH, FONTHEIGHT)  -- 字号

-- ===================================================================
-- 界面配置（对话框、选项菜单位置）
include("config.lua")

-- ===================================================================
-- 开始你的剧本
jump("main.ev")
