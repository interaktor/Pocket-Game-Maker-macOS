-- ═══════════════════════════════════════════════════════════════
--  ★ 这就是你要改的文件：src/user/main.ev
--
--  · 一行一条指令，从上往下执行
--  · 中文直接写，UTF-8 就行（引擎自动转换，不用管编码）
--  · 改完保存，重新运行就能看到效果，不需要打包
--
--  写台词的固定套路：一句 text(...)，紧跟一句 textcl()
--  textcl() 是"这句说完了，清屏"，漏了下一句会接在同一行上
-- ═══════════════════════════════════════════════════════════════


*start

msgboxon()                          -- 显示对话框，开局调一次
bg("backdrop.png")                  -- 换背景（自带淡入），图在 src/files/bg/


-- ── 第一段：纯台词 ──────────────────────────────────────

text("这是一个可以直接改的示例。")
textcl()

text("你现在看到的每一句话，都写在 src/user/main.ev 里。")
textcl()

text("用任何编辑器打开它，改掉文字，保存，再运行一次。")
textcl()


-- ── 第二段：带名字的台词 ────────────────────────────────

text("旁白","中文不用做任何处理，UTF-8 直接写。")
textcl()

text("旁白","想让某几个字变色，就这样写：")
textcl()

text("[c=FFD700]金色[/c]  [c=00FF88]绿色[/c]  [c=FF6B6B]红色[/c]")
textcl()


-- ── 第三段：怎么放图、放音乐 ────────────────────────────

text("想换背景：把 png 丢进 src/files/bg/，然后写 bg(文件名)。")
textcl()

text("想加立绘：把 png 丢进 src/files/fg/，然后写 fg(文件名)。")
textcl()

text("想放音乐：把 mp3 丢进 bin/data/bgm/，然后写 bgm(文件名)。")
textcl()


-- ── 选项 ────────────────────────────────────────────────
--  drawramus 后面成对写「文字, 跳转标签」，标签以 * 开头

drawramus("再看一遍",*again,"我知道了",*quit)


*again
text("好，那就从头再来。")
textcl()
goto(*start)


*quit
text("祝顺利。")
textcl()

-- 回到开头。想让示例自己结束，把下面这行删掉
jump("main.ev")
