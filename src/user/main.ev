-- ═══════════════════════════════════════════════════════════════
--  《雨停之前》 —— PGM for Mac 测试游戏
--
--  用到的能力：背景切换 / 立绘（左中右）/ 转场音效 /
--              两段 BGM / 选项分支 / 变量记录 / 双结局
-- ═══════════════════════════════════════════════════════════════


*start

msgboxon()

-- ── 序章 · 夜 ───────────────────────────────────────────
bgm("theme.wav")
bg("night.png")
sound("whoosh.wav")

text("雨是傍晚开始下的。")
textcl()

text("我站在校门口，看着那栋三年没进过的教学楼。")
textcl()

text("走廊的灯还亮着，跟记忆里一模一样。")
textcl()

text("毕业之后我一次都没回来过。")
textcl()

text("今天路过这里，本来只是想等雨停。")
textcl()


-- ── 第一幕 · 教室 ───────────────────────────────────────

bgmstop()
sound("whoosh.wav")
bg("room.png")
bgm("calm.wav")

text("我还是上去了。")
textcl()

text("三楼，最东边那间。")
textcl()

text("门没锁。")
textcl()

fg("heroine.png")

text("……有人。")
textcl()

text("靠窗的位置坐着一个人，低着头，在写什么。")
textcl()

text("听到门响，她抬起头。")
textcl()

text("小满","啊。")
textcl()

text("是林小满。")
textcl()

text("小满","你怎么会在这儿？")
textcl()

text("……我也想问这句话。")
textcl()

text("小满","外面雨很大吧，你衣服都湿了。")
textcl()

text("她把桌上那包纸巾推过来。")
textcl()

sound("click.wav")

text("这个小动作我太熟悉了。")
textcl()

text("高中三年，她永远坐在这个位置，永远多带一包纸巾。")
textcl()

text("小满","我刚才还在想，如果有个人推门进来就好了。")
textcl()

text("我说不清她那句话是什么意思。")
textcl()

goto(*choice)


-- ── 第二幕 · 选择 ───────────────────────────────────────

*choice
sound("click.wav")
drawramus("问她为什么还在这里",*ask,"什么也不说，坐下",*sit)


*ask
text("我问她，为什么这么晚了还在这里。")
textcl()

text("小满","因为今天是个特别的日子啊。")
textcl()

text("小满","三年前的今天，我们在这里说的最后一句话。")
textcl()

text("我想起来了。")
textcl()

text("那天我说的是「以后再说吧」。")
textcl()

text("然后就没有以后了。")
textcl()

goto(*rain)


*sit
text("我没说话，在她前排坐下。")
textcl()

text("跟三年前一样的位置。")
textcl()

text("她也没再开口。")
textcl()

text("窗户外面雨声很大，屋里很安静。")
textcl()

text("安静得让我觉得，这三年好像没过去。")
textcl()

goto(*rain)


-- ── 第三幕 · 走廊 ───────────────────────────────────────

*rain
bgmstop()
fgcl()
sound("whoosh.wav")
bg("street.png")
bgm("theme.wav")

text("雨小了一点。")
textcl()

fg("hero.png",LEFT)

text("我们一起下楼。")
textcl()

text("走廊的灯一盏一盏灭在身后。")
textcl()

text("小满","你以前总说，等毕业了要回来把天台的门修好。")
textcl()

text("我说过这种话吗。")
textcl()

text("小满","说过。你还说要把它刷成蓝色。")
textcl()

text("……好像真的说过。")
textcl()

text("小满","结果你一次都没回来。")
textcl()

text("我想说点什么，但什么都没说出来。")
textcl()

fgcl()
bg("night.png")

text("一楼。雨几乎停了。")
textcl()


-- ── 终章 · 选择 ─────────────────────────────────────────

sound("click.wav")
drawramus("「以后再说吧」这次不说了",*good,"还是什么也不说",*bad)


*good
text("我说，那我明年这个时候还来。")
textcl()

text("小满愣了一下，然后笑了。")
textcl()

text("[c=FFD700]「说好了。这次别再拖三年。」[/c]")
textcl()

sound("chime.wav")
text("雨停了。")
textcl()

goto(*end)


*bad
text("我只是点了点头，转身走进夜里。")
textcl()

text("身后的灯，一盏一盏灭了。")
textcl()

sound("whoosh.wav")
text("雨又下了起来。")
textcl()

goto(*end)


*end
bgmstop()
fgcl()

text("—— 《雨停之前》 完 ——")
textcl()

text("这个例子用到了：背景、立绘（左/中）、两段 BGM、三个音效、")
textcl()

text("选项分支、变量与双结局。全部内容都在 src/user/main.ev 里。")
textcl()

drawramus("再玩一次",*start,"退出",*quit)


*quit
textclear()
jump("main.ev")
